# Copy to .env and fill in. Never commit .env (this repo is public).

# Password for the login screen. Required if the app is reachable from the
# internet (Cloudflare Tunnel, Tailscale Funnel). Leave empty only on a trusted LAN.
APP_PASSWORD=

# Signs the login cookie. Generate one with:  openssl rand -hex 32
SECRET_KEY=

# Turns on paste extraction, fit checks, tailored resumes and cover letters.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Local model through Ollama (on the Mac mini). Leave OLLAMA_URL as is when the
# app runs in Docker on the same Mac; set it empty to hide the Local option.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:14b
# Which model is picked first in the app: claude or local
# DEFAULT_ENGINE=claude
# OLLAMA_NUM_CTX=16384
# OLLAMA_TIMEOUT=900

# Overnight runs use this time zone
TZ_NAME=Asia/Singapore

# Lets n8n / iOS Shortcuts add jobs:  header  X-API-Key: <API_TOKEN>
# Generate one with:  openssl rand -hex 24
API_TOKEN=

# Optional
# SESSION_DAYS=90
# COOKIE_SECURE=auto
